        <mxCell id="G5oOuhXXY4_krbKrTRHi-15" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;b&gt;Synchrone Nachricht: &lt;/b&gt;Zeigt an, dass der Sender eine Anfrage sendet und auf die Anwort des Empfängers wartet." vertex="1">
          <mxGeometry height="70" width="280" x="840" y="70" as="geometry" />
        </mxCell>
        <mxCell id="G5oOuhXXY4_krbKrTRHi-16" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0" value="&lt;b&gt;Asynchrone Nachricht:&amp;nbsp;&lt;/b&gt;Zeigt an, dass der Sender eine Nachricht und sofort weiterarbeitet, ohne auf eine Anwort zu warten." vertex="1">
          <mxGeometry height="70" width="270" x="840" y="130" as="geometry" />
        </mxCell>
        <mxCell id="G5oOuhXXY4_krbKrTRHi-17" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;b&gt;Asynchrone Antwort:&amp;nbsp;&lt;/b&gt;Zeigt an, dass die Antwort auf eine Nachricht asynchron und nicht blockierend erfolgt.*" vertex="1">
          <mxGeometry height="70" width="280" x="840" y="250" as="geometry" />
        </mxCell>
        <mxCell id="G5oOuhXXY4_krbKrTRHi-18" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;b&gt;Asynchrone Nachrichtenerstellung&lt;/b&gt;: Zeigt an, dass der Sender ein neues lauschendes Objekt erstellt und selbst nicht blockiert wird. (TCP basierter Server)" vertex="1">
          <mxGeometry height="70" width="280" x="840" y="414" as="geometry" />
        </mxCell>
        <mxCell id="G5oOuhXXY4_krbKrTRHi-19" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;b&gt;Synchrone Nachricht / asynchrone Antwort:&lt;/b&gt; Zeigt an, dass der Sender auf die Antwort des Empfängers wartet, der antwortende Empfänger aber nicht mehr." vertex="1">
          <mxGeometry height="70" width="280" x="835" y="344" as="geometry" />
        </mxCell>
        <mxCell id="G5oOuhXXY4_krbKrTRHi-20" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;b&gt;Löschnachricht:&lt;/b&gt; Zeigt an, dass das Objekt nach dem Empfang der Nachricht gelöscht wird. (TCP basiertert Server)" vertex="1">
