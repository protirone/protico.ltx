        <mxCell id="nAZZkY7-7bmLWZ5RMX5y-44" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Darstellung einer Klasse oder eines Objekts. Es zeigt, wie sich ein Objekt im Kontext des Systems verhalten wird. &lt;/font&gt;" vertex="1">
