        <mxCell id="XZ4UMpl45DTZkbO10MgW-5" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#ff0080&quot; style=&quot;background-color: transparent;&quot;&gt;&lt;font color=&quot;#ff0080&quot; style=&quot;font-size: 14px;&quot;&gt;OMG-Spezifikation: &lt;/font&gt;&lt;/font&gt;&lt;i style=&quot;background-color: transparent; color: rgb(0, 0, 204);&quot;&gt;(Kap. 17: Interactions = S.565ff, besonders: Sequence Diagrams =S.595ff)&amp;nbsp;&lt;/i&gt;&lt;div style=&quot;background-color: transparent;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;font color=&quot;#ff0080&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;https://www.omg.org/spec/UML/2.5.1/PDF &lt;/span&gt;&lt;/font&gt;(Kap. 15 = S.373-440)&lt;/li&gt;&lt;/ul&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 0, 128); font-size: 14px; background-color: transparent;&quot;&gt;Anleitungen (Interpretationen):&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;ul&gt;&lt;li&gt;&lt;font color=&quot;#ff0080&quot;&gt;Kecher u.a.: UML 2.5, Bonn 2021, S. 357ff&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font color=&quot;#ff0080&quot;&gt;https://de.wikipedia.org/wiki/Sequenzdiagramm&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font color=&quot;#ff0080&quot;&gt;https://www.lucidchart.com/pages/de/uml-sequenzdiagramme&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font color=&quot;#ff0080&quot;&gt;https://www.oose.de/wp-content/uploads/2012/05/UML-Notations%C3%BCbersicht-2.5.pdf&lt;/font&gt;&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
