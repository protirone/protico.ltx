        <mxCell id="BJep5_tqjKtV8PmbfBUi-2" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;b&gt;Synchrone Antwort:&amp;nbsp;&lt;/b&gt;Zeigt an, dass die Antwort auf eine Nachricht synchron und blockierend erfolgt.*" vertex="1">
