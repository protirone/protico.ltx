        <mxCell id="nAZZkY7-7bmLWZ5RMX5y-51" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;L&lt;b&gt;ebenslinie: &lt;/b&gt;Zeigt, wann ein Objekt oder Akteur aktiv ist und wann Nachrichten gesendet oder empfangen werden.&lt;/font&gt;" vertex="1">
