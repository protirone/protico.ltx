        </mxCell>
        <mxCell id="nAZZkY7-7bmLWZ5RMX5y-45" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Repräsentiert die Zeit, die en Objekt zum Abschließen einer Aufgabe benötigt. Je länger die Ausführung der Aufgabe dauert, desto länger der Aktivitätsbalken.&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="350" x="210" y="150" as="geometry" />
