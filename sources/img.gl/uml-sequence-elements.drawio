        <mxCell id="nAZZkY7-7bmLWZ5RMX5y-46" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Stellt Entitäten dar, die mit de System interagieren bzw. systemintern sind.&lt;/font&gt;" vertex="1">
